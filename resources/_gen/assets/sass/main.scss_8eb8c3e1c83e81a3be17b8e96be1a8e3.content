:root{--background:#ffffff;--text:#1f2937;--text-muted:#6b7280;--primary:#005a9c;--primary-hover:#00467a;--secondary:#0f766e;--secondary-hover:#115e59;--accent:#d97706;--border:#e5e7eb}*{box-sizing:border-box}html,body{height:100%;margin:0}body{min-height:100vh;display:flex;margin:0;font-family:system-ui,sans-serif;color:var(--text);background:var(--background);line-height:1.6;background-image:linear-gradient(to right,rgba(0,90,156,5%) 1px,transparent 1px),linear-gradient(to bottom,rgba(0,90,156,5%) 1px,transparent 1px);background-size:40px 40px}h1{margin-bottom:0;padding:0 2rem;overflow-wrap:anywhere}h2{margin-top:.5rem;margin-bottom:.5rem;padding:0 2rem}h3{margin-top:.5rem;margin-bottom:.5rem;padding:0 2rem}.hero-content{width:100%;max-width:1100px;margin:0 auto}.hero-content h3{width:100%;max-width:100%;margin:0 auto;padding:0 2.5rem;text-align:center;overflow-wrap:break-word}.hero-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem;width:100%;padding:0 1rem;margin:1.5rem auto 0}.hero-headshot-link{position:relative;display:inline-block;max-width:100%;aspect-ratio:1/1;border-radius:50%;overflow:hidden;z-index:1}.hero-image{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover;border:3px solid #9db7cc;box-sizing:border-box;transition:border-color .25s ease}.hero-headshot-link:hover .hero-image,.hero-headshot-link:focus-visible .hero-image{border-color:#1f3a5f}.hero-headshot-link:hover .headshot-overlay,.hero-headshot-link:focus-visible .headshot-overlay{opacity:1}.headshot-overlay{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;padding:1.5rem;border-radius:50%;background:rgba(0,17,62,.55);color:#fff;font-size:1rem;line-height:1.3;font-weight:600;text-align:center;text-shadow:0 1px 4px rgba(0,0,0,.5);opacity:0;transition:opacity .25s ease}@media(max-width:768px){h1,h2{padding:0 1rem}}.container{width:95%;max-width:1500px;margin:0 auto}.navbar{max-width:none;width:100%;border-bottom:1px s